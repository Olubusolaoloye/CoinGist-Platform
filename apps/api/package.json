{
  "name": "@coingist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local": "tsx watch src/dev.ts",
    "start:local": "tsx src/dev.ts",
    "job:publish-scheduled": "tsx --env-file-if-exists=../../.env src/jobs/publish-scheduled.ts",
    "job:sync-newsletter": "tsx --env-file-if-exists=../../.env src/jobs/sync-newsletter.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@coingist/db": "workspace:*",
    "@coingist/types": "workspace:*",
    "@electric-sql/pglite": "^0.3.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.5.0",
    "@sentry/node": "^11.14.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./auth": "./src/auth.ts",
    "./newsletter/dev-provider": "./src/newsletter/dev-provider.ts",
    "./prices": "./src/prices/provider.ts"
  }
}
