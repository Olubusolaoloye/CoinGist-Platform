{
  "name": "@coingist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local": "tsx watch src/dev.ts",
    "start:local": "tsx src/dev.ts"
  },
  "dependencies": {
    "@coingist/db": "workspace:*",
    "@coingist/types": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.5.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "zod": "^3.24.0",
    "@electric-sql/pglite": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
