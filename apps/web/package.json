{
  "name": "@coingist/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5173",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test:e2e": "playwright test --trace off",
    "dev:local": "API_URL=http://localhost:8787 react-router dev --port 5173",
    "test": "vitest run",
    "build:functions": "esbuild netlify/functions-src/api.mts --bundle --platform=node --format=esm --target=node22 --external:@electric-sql/pglite --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=netlify/functions/api.mjs"
  },
  "dependencies": {
    "@coingist/api": "workspace:*",
    "@coingist/db": "workspace:*",
    "@coingist/seo": "workspace:*",
    "@coingist/types": "workspace:*",
    "@coingist/ui": "workspace:*",
    "@electric-sql/pglite": "^0.3.16",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@hono/zod-validator": "^0.5.0",
    "@react-router/node": "~7.18.5",
    "@react-router/serve": "~7.18.5",
    "@sentry/node": "^11.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.18",
    "isbot": "^5.1.0",
    "jose": "^6.2.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "~7.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@netlify/functions": "^6.1.1",
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "~7.18.5",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.1.0"
  }
}
