{
  "name": "@coingist/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5174",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "dev:local": "STUDIO_AUTH=dev API_URL=http://localhost:8787 react-router dev --port 5174",
    "build:functions": "for f in api publish-scheduled; do esbuild netlify/functions-src/$f.mts --bundle --platform=node --format=esm --target=node22 --external:pg-native --banner:js=\"import { createRequire as __cgCreateRequire } from 'node:module'; const require = __cgCreateRequire(import.meta.url);\" --outfile=netlify/functions/$f.mjs || exit 1; done"
  },
  "dependencies": {
    "@coingist/seo": "workspace:*",
    "@coingist/types": "workspace:*",
    "@coingist/ui": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@react-router/node": "~7.18.5",
    "@react-router/serve": "~7.18.5",
    "@sentry/node": "^11.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "isbot": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "~7.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@coingist/api": "workspace:*",
    "@coingist/db": "workspace:*",
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "~7.18.5",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.1.0"
  }
}
