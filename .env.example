# ── API ──────────────────────────────────────────────────────────────────
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# Supabase project URL (token issuer). JWTs are verified via JWKS unless the legacy secret is set.
SUPABASE_URL=http://localhost:54321
# SUPABASE_JWT_SECRET=only-for-legacy-HS256-projects-32+chars
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Newsletter (API) ─────────────────────────────────────────────────────
# "beehiiv" in production; "dev" logs instead of emailing (refused in production)
NEWSLETTER_PROVIDER=beehiiv
BEEHIIV_API_KEY=replace-me
BEEHIIV_PUBLICATION_ID=pub_replace-me
# Signing secret from Beehiiv's webhook settings; webhook URL: {API}/v1/webhooks/newsletter
BEEHIIV_WEBHOOK_SECRET=whsec_replace-me

# ── AI assist (API) ──────────────────────────────────────────────────────
# Turns on AI assist in Studio (Claude). Without a key: off in production; locally the
# offline sample generator stands in.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Requests per person per UTC day
# AI_DAILY_LIMIT_WRITER=40
# AI_DAILY_LIMIT_EDITOR=150
# RSS/Atom feeds for the editors' trending digest (comma-separated, https only)
# TRENDING_FEEDS=https://example.com/feed.xml,https://example.org/rss

# ── Public site (apps/web) ───────────────────────────────────────────────
API_URL=http://localhost:8787
SITE_URL=http://localhost:5173
# SITE_X_HANDLE=@coingist
# Plausible analytics (privacy-friendly, no cookies). Leave unset to disable.
# PLAUSIBLE_DOMAIN=coingist.com
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
# Newsletter signups allowed per visitor IP per 10 minutes
# NEWSLETTER_SIGNUPS_PER_10_MIN=5

# ── Studio (apps/studio) ─────────────────────────────────────────────────
STUDIO_URL=http://localhost:5174
# "supabase" (default in production) or "dev" (local seeded sign-in; refused in production)
STUDIO_AUTH=supabase
SUPABASE_ANON_KEY=replace-with-your-project-anon-key
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-me
