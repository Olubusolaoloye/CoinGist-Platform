# ── API ──────────────────────────────────────────────────────────────────
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# Supabase project URL (token issuer). JWTs are verified via JWKS unless the legacy secret is set.
SUPABASE_URL=http://localhost:54321
# SUPABASE_JWT_SECRET=only-for-legacy-HS256-projects-32+chars
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Public site (apps/web) ───────────────────────────────────────────────
API_URL=http://localhost:8787
SITE_URL=http://localhost:5173
# SITE_X_HANDLE=@coingist

# ── Studio (apps/studio) ─────────────────────────────────────────────────
STUDIO_URL=http://localhost:5174
# "supabase" (default in production) or "dev" (local seeded sign-in; refused in production)
STUDIO_AUTH=supabase
SUPABASE_ANON_KEY=replace-with-your-project-anon-key
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-me
